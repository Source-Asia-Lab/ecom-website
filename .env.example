# PostgreSQL connection URL. Use sslmode=verify-full for remote databases.
# Keep DATABASE_URL read-only for ERP access; use a different PostgreSQL database here.
# Local e-commerce test login: sourceasia_ecom_test (create with createuser --pwprompt).
ECOMMERCE_DATABASE_URL=postgresql://sourceasia_ecom_test:CHANGE_ME@localhost:5432/sourceasia_ecommerce?sslmode=disable
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth web client credentials (server-only secrets)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated, exact Google account emails allowed into staff routes
AUTH_STAFF_EMAILS=

# Set true only when required by the production host's trusted proxy setup
AUTH_TRUST_HOST=false

# Notification worker: schedule POST /api/worker/notifications with this bearer token.
NOTIFICATION_WORKER_TOKEN=

# Resend transactional email
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_ORDERS_EMAIL=
NOTIFICATION_SUPPORT_EMAIL=

# Twilio SMS (optional; queued SMS retries until configured or reaches the dead-letter state)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Enable only after production rate limiting and bot protection are configured.
# ORDER_REQUESTS_ENABLED=false

# Optional development storefront product filters.
# DEV_STOREFRONT_PRODUCT_IDS=
# DEV_STOREFRONT_PRODUCT_SKUS=
