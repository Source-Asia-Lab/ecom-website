# PostgreSQL connection URL. Use sslmode=verify-full for remote databases.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Enable only after production rate limiting and bot protection are configured.
# ORDER_REQUESTS_ENABLED=false

# Optional development storefront product filters.
# DEV_STOREFRONT_PRODUCT_IDS=
# DEV_STOREFRONT_PRODUCT_SKUS=
